\newlabel{app:per_env}{{A}{7}{}{appendix.A}{}}
\newlabel{fig:lc_cartpole}{{7}{8}{Learning curves on \texttt {cartpole\_swingup} (3 seeds). The implicit agent dominates from step 10k onward; the explicit agent shows limited but stable improvement}{figure.7}{}}
\newlabel{fig:lc_walker}{{8}{8}{Learning curves on \texttt {walker\_walk} (3 seeds). The implicit agent achieves near-expert locomotion ($\approx 950$ return); the explicit agent remains well below 100}{figure.8}{}}
\newlabel{fig:kl_cartpole}{{9}{8}{KL utilisation on \texttt {cartpole\_swingup} (3 seeds). A similar collapse pattern as LiftCube-v0 is observed, with recovery partially occurring in some seeds}{figure.9}{}}
\newlabel{fig:kl_walker}{{10}{8}{KL utilisation on \texttt {walker\_walk} (3 seeds). The collapse is consistent; the explicit agent never recovers full variable utilisation on the locomotion task}{figure.10}{}}
\newlabel{fig:planner_health}{{11}{8}{MPPI planner health on \texttt {LiftCube-v0} (3 seeds). Top: one-step consistency error (\texttt {consistency\_t0}). Middle: multi-step consistency error (\texttt {consistency\_tH}). Bottom: elite-value diversity (\texttt {mppi\_elite\_value\_std}). The horizon degradation ratio tH/t0 drops below 1 after step 10k (healthy dynamics), and planner diversity remains volatile but non-zero}{figure.11}{}}
\newlabel{fig:sample_efficiency}{{12}{8}{Sample efficiency: steps to reach 50\% of each agent's peak return across all three environments. The implicit agent reaches criterion faster on all tasks}{figure.12}{}}
\newlabel{fig:geo_cartpole}{{13}{9}{Geometry evolution on \texttt {cartpole\_swingup} (3 seeds). The same opposing trends (explicit PR decreasing, implicit PR growing) are observed as on LiftCube-v0}{figure.13}{}}
\newlabel{fig:geo_walker}{{14}{9}{Geometry evolution on \texttt {walker\_walk} (3 seeds). The explicit agent's participation ratio decreases more sharply on this higher-dimensional observation task}{figure.14}{}}
